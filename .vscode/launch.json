{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Stella (PC, web en :7777)",
            "type": "debugpy",
            "request": "launch",
            "module": "stella",
            "args": ["--config", "data/config.yaml"],
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Stella headless (solo cruces)",
            "type": "debugpy",
            "request": "launch",
            "module": "stella",
            "args": ["--config", "data/config.yaml", "--headless"],
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: archivo actual",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
